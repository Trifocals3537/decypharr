[Unit]
Description=Decypharr media gateway
Documentation=https://github.com/Trifocals3537/decypharr

[Service]
Type=simple
ExecStart=%h/.local/bin/decypharr --config %h/.decypharr
EnvironmentFile=-%h/.decypharr/environment
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
LimitNOFILE=65536

[Install]
WantedBy=default.target
